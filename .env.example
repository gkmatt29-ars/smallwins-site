# Public browser configuration (safe to expose in a Vite client build)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Backward-compatible alternative if this project still uses the legacy anon JWT:
# VITE_SUPABASE_ANON_KEY=YOUR_LEGACY_SUPABASE_ANON_KEY

# Edge Function secrets: set with `supabase secrets set`; do not place these in a browser .env file.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# RESEND_API_KEY=YOUR_RESEND_API_KEY
# LEAD_NOTIFICATION_EMAIL=gkmatt29@gmail.com
# LEAD_FROM_EMAIL=Small Wins <notifications@your-verified-domain.com>
# ALLOWED_ORIGINS=https://smallwins.ai,https://www.smallwins.ai,http://localhost:5173,http://localhost:8080
